<html> <!-- Indica que aquí inicia nuestro archivo HTML -->
    <head>     <!-- Encabezado -->
        <title>Página WEB de ejemplo: texto</title>  <!-- Título que se muestra en el link -->
    </head>     <!-- Cierra el encabezado -->

<!-- Cuerpo de la página: definimos que todo el texto por defecto sea naranja -->
<body text="orange">
    <!-- Usa <b> para negrita, <u> para subrayar y <br/> para saltar de línea -->
    <b>Esta es una línea</b>, y a continuación <b><u>insertamos un salto</u></b> de línea.<br/>

    <!-- Texto sencillo con una parte subrayada mediante <u> y salto de renglón -->
    Esta es una línea, y <u>a continuación insertamos</u> un salto de línea.<br/>

    <!-- Usa <strong> para negrita importante e <i> para letra inclinada o cursiva -->
    Esta es una línea, y <strong>a continuación</strong> insertamos un <i>salto de línea</i>.<br/>

    <!--Cambia el color a verde y el tamaño de texto con la etiqueta <font>-->
    <font color="green" size="11px">Esta es una línea</font>, y a continuación insertamos un <i>salto de línea</i>.<br/>

    <!-- Cambia la tipografía a Arial y el color de texto a rojo -->
    <font face="Arial">Esta es una</font> línea, y <font color="red">a continuación</font> insertamos un salto de línea.<br/>

    <!-- Un párrafo <p> que mezcla color cian, subrayado <u> y negrita <b> -->
    <p>Este es una párrafo <font color="cyan">con <u>la letra</u> en <b>diferentes formatos</b></font></p>
<!-- Cierre el cuerpo de la página -->
</body>
<!-- Fin de todo el documento HTML -->
</html>

